{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "it",
    "supported": [
      "Base",
      "en",
    ],
  },
  "files": [
    { "kind": "folder", "path": "MacroBara", "target-membership": [ "MacroBara" ] },
    { "kind": "folder", "path": "MacroBaraWidgetExtension", "target-membership": [ "MacroBaraWidgetExtension" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MacroBara.app", "id": "37D4A08F3097631D00A55873", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MacroBaraWidgetExtension.appex", "id": "37D4A08F3097631D00A55899", "type": "wrapper.app-extension", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "MacroBara",
      "id": "37D4A08E3097631D00A55873",
      "product": "Products/MacroBara.app",
      "product-type": "application",
      "dependencies": [
        "MacroBaraWidgetExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Embed Widget Extension",
          "shell": "/bin/sh",
          "outputs": [
            "$(TARGET_BUILD_DIR)/$(WRAPPER_NAME)/PlugIns/MacroBaraWidgetExtension.appex"
          ],
          "script": [
            "set -e",
            "PLUGINS_DIR=\"${TARGET_BUILD_DIR}/${WRAPPER_NAME}/PlugIns\"",
            "mkdir -p \"$PLUGINS_DIR\"",
            "rm -rf \"$PLUGINS_DIR/MacroBaraWidgetExtension.appex\"",
            "WIDGET_PATH=\"\"",
            "for CANDIDATE in \\",
            "  \"${BUILT_PRODUCTS_DIR}/MacroBaraWidgetExtension.appex\" \\",
            "  \"${CONFIGURATION_BUILD_DIR}/MacroBaraWidgetExtension.appex\" \\",
            "  \"${OBJROOT}/ArchiveIntermediates/${TARGET_NAME}/BuildProductsPath/${CONFIGURATION}${EFFECTIVE_PLATFORM_NAME}/MacroBaraWidgetExtension.appex\" \\",
            "  \"${OBJROOT}/ArchiveIntermediates/${TARGET_NAME}/IntermediateBuildFilesPath/UninstalledProducts/iphoneos/MacroBaraWidgetExtension.appex\" \\",
            "  \"${SYMROOT}/${CONFIGURATION}${EFFECTIVE_PLATFORM_NAME}/MacroBaraWidgetExtension.appex\"; do",
            "  if [ -e \"$CANDIDATE\" ]; then",
            "    WIDGET_PATH=\"$CANDIDATE\"",
            "    break",
            "  fi",
            "done",
            "if [ -z \"$WIDGET_PATH\" ]; then",
            "  WIDGET_PATH=$(find \"${OBJROOT:-$BUILD_DIR}\" -name \"MacroBaraWidgetExtension.appex\" 2>/dev/null | head -n 1)",
            "fi",
            "if [ -n \"$WIDGET_PATH\" ] && [ -e \"$WIDGET_PATH\" ]; then",
            "  echo \"Embedding Widget from: $WIDGET_PATH\"",
            "  cp -RL \"$WIDGET_PATH\" \"$PLUGINS_DIR/\"",
            "  if [ -n \"${EXPANDED_CODE_SIGN_IDENTITY:-}\" ]; then",
            "    codesign --force --sign \"${EXPANDED_CODE_SIGN_IDENTITY}\" --timestamp=none --generate-entitlement-der \"$PLUGINS_DIR/MacroBaraWidgetExtension.appex\"",
            "  fi",
            "else",
            "  echo \"Warning: MacroBaraWidgetExtension.appex not found\"",
            "fi",
            "",
          ],
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "MacroBara/MacroBara.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "N4B2W232Q9",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "MacroBara",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.food-and-drink",
        "INFOPLIST_KEY_NSHealthShareUsageDescription": "MacroBara legge i dati di passi e calorie attive da Apple Watch per calcolare il deficit metabolico reale.",
        "INFOPLIST_KEY_NSHealthUpdateUsageDescription": "MacroBara registra i dati di idratazione e peso su Apple Health.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.macrobara.app",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "MacroBaraWidgetExtension",
      "id": "37D4A08E3097631D00A55899",
      "product": "Products/MacroBaraWidgetExtension.appex",
      "product-type": "app-extension",
      "build-phases": [
